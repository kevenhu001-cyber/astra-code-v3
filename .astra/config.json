{
  "providers": [
    {
      "id": "openai",
      "type": "openai-compatible",
      "name": "OpenAI",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        "gpt-4o",
        "gpt-4o-mini"
      ]
    },
    {
      "id": "anthropic",
      "type": "anthropic",
      "name": "Anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_AUTH_TOKEN",
      "models": [
        "claude-sonnet-4-20250514",
        "claude-3-5-sonnet-20241022"
      ]
    },
    {
      "id": "deepseek",
      "type": "openai-compatible",
      "name": "DeepSeek",
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ]
    },
    {
      "id": "qwen",
      "type": "openai-compatible",
      "name": "Qwen (DashScope)",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "models": [
        "qwen-plus",
        "qwen-max",
        "qwen-coder-plus"
      ]
    },
    {
      "id": "openrouter",
      "type": "openai-compatible",
      "name": "OpenRouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "models": [
        "openai/gpt-4o",
        "anthropic/claude-sonnet-4"
      ]
    },
    {
      "id": "ollama",
      "type": "openai-compatible",
      "name": "Ollama (local)",
      "base_url": "http://localhost:11434/v1",
      "api_key_env": "OLLAMA_API_KEY",
      "models": [
        "llama3.1",
        "qwen2.5-coder"
      ]
    }
  ],
  "permission_mode": "ask",
  "max_iterations": 20,
  "max_context_tokens": 160000,
  "auto_verify": true,
  "timeout_seconds": 120,
  "max_project_doc_bytes": 32768,
  "status_line": [
    "model-with-reasoning",
    "current-dir"
  ],
  "status_line_use_colors": true,
  "keymap": {
    "backtrack": "esc",
    "clear": "ctrl+l",
    "copy": "ctrl+shift+c",
    "external_editor": "ctrl+g",
    "history_search": "ctrl+r",
    "interrupt_or_quit": "ctrl+c",
    "model_picker": "ctrl+m",
    "new_session": "ctrl+n",
    "newline": "ctrl+j",
    "open_help": "?",
    "page_down": "pgdn",
    "page_up": "pgup",
    "palette": "ctrl+k",
    "paste_image": "ctrl+v",
    "permission_allow": "y",
    "permission_always": "a",
    "permission_deny": "n",
    "permission_never": "N",
    "quit": "ctrl+d",
    "scroll_down": "ctrl+down",
    "scroll_up": "ctrl+u",
    "transcript": "ctrl+t"
  }
}